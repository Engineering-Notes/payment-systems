# Copy to .env (never commit .env) or export these in your shell.

# Articles 01 and 02. Leave unset to use each script's default database
# (ledger for 01, idem for 02). Set it only when running one article
# against a different server, for example:
# DATABASE_URL=postgres://user:password@host:5432/ledger

# Article 03
APP_DATABASE_URL=postgres://ledger:ledger@localhost:5432/outbox
CONSUMER_DATABASE_URL=postgres://ledger:ledger@localhost:5432/consumer

# Article 04, only when evaluating a real model with anthropic-adapter.mjs
ANTHROPIC_API_KEY=
MODEL=
